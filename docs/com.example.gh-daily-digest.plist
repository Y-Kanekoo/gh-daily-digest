<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.gh-daily-digest</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/gh-daily-digest</string>
        <string>--output-dir</string>
        <string>__HOME__/gh-daily-digest/digests</string>
        <string>--no-discord</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__HOME__/gh-daily-digest</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:__HOME__/.local/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/gh-daily-digest/digest.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/gh-daily-digest/digest-error.log</string>
</dict>
</plist>
